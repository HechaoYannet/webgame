{
  "permissions": {
    "allow": [
      "Bash(npm create vite:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(curl https://raw.githubusercontent.com/*)",
      "Bash(curl https://registry.npmjs.org/*)",
      "Bash(curl https://api.github.com/*)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(mkdir:*)",
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "env": {
    "GITHUB_PAGES": "true"
  }
}
